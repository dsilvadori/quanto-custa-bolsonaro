---
import { Link } from '@boralula/ui';
import Base from '../layouts/Base.astro';
import { FiltroOrgaos } from '../components/FiltroOrgaos';
import { BotaoBaixar } from '../components/BotaoBaixar';
import { FONTES } from '../fontes';
import { ARQUIVOS } from '../arquivos-dados';
import { PAGINAS, SIMULADORES, SITE, dataPorExtenso } from '../site';

// Agrupado por simulador; uma fonte usada em dois simuladores aparece no primeiro.
const grupos = SIMULADORES.map((id) => ({
  id,
  pagina: PAGINAS[id],
  fontes: FONTES.filter((f) => f.usado_em[0] === PAGINAS[id].path),
})).filter((g) => g.fontes.length > 0);
const orgaos = [...new Set(FONTES.map((f) => f.orgao))].sort((a, b) => a.localeCompare(b, 'pt-BR'));
const arquivoUrl = (nome: string) => new URL(`/dados/${nome}`, Astro.site).href;

const jsonLd = ARQUIVOS.map((a) => ({
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: a.nome,
  description: a.descricao,
  url: new URL(PAGINAS.fontes.path, Astro.site).href,
  inLanguage: 'pt-BR',
  creator: { '@type': 'Organization', name: SITE.nome },
  isAccessibleForFree: true,
  distribution: [
    {
      '@type': 'DataDownload',
      encodingFormat: a.tipo.split(';')[0],
      contentUrl: arquivoUrl(a.nome),
    },
  ],
  ...(a.baseadoEm.length ? { isBasedOn: a.baseadoEm } : {}),
}));
---

<Base id="fontes" jsonLd={jsonLd}>
  <p slot="lead" class="hero__lead cp-text-body-large">
    Cada número do site vem de uma destas fontes. Para cada uma, mostramos o valor exato usado, a data e uma cópia arquivada.
  </p>

  <section class="secao secao--cinza" aria-labelledby="lista">
    <div class="cp-container">
      <h2 id="lista" class="cp-text-h2">Fontes por simulador</h2>
      <FiltroOrgaos orgaos={orgaos} />
      <p class="cp-text-body-small ajuda" role="status" data-filtro-contagem>{FONTES.length} fontes.</p>
      <div class="registro" data-registro-fontes>
        {
          grupos.map((g) => (
            <section aria-labelledby={`grupo-${g.id}`}>
              <h3 id={`grupo-${g.id}`} class="cp-text-h3">
                {g.pagina.rotulo}
              </h3>
              {g.fontes.map((f) => (
                <article id={f.id} data-orgao={f.orgao}>
                  <p class="cp-text-label-small">{f.orgao}</p>
                  <h4 class="cp-text-title">{f.titulo}</h4>
                  <dl class="cp-text-body-small">
                    <dt>Valor usado</dt>
                    <dd>{f.valor_usado}</dd>
                    <dt>Publicado em</dt>
                    <dd>
                      {f.data_publicacao ? (
                        <time datetime={f.data_publicacao}>{dataPorExtenso(f.data_publicacao)}</time>
                      ) : (
                        'em atualização'
                      )}
                    </dd>
                    <dt>Coletado em</dt>
                    <dd>
                      <time datetime={f.data_coleta}>{dataPorExtenso(f.data_coleta)}</time>
                    </dd>
                  </dl>
                  <p>
                    <Link href={f.url} external>
                      Abrir fonte
                    </Link>
                    {f.url_arquivo && (
                      <>
                        {' · '}
                        <Link href={f.url_arquivo} external>
                          Cópia arquivada
                        </Link>
                      </>
                    )}
                  </p>
                </article>
              ))}
            </section>
          ))
        }
      </div>
    </div>
  </section>

  <section class="secao" aria-labelledby="baixar">
    <div class="cp-container">
      <h2 id="baixar" class="cp-text-h2">Baixar os dados</h2>
      <p class="texto">Os mesmos arquivos que o site usa para fazer as contas. Pode usar e compartilhar.</p>
      <ul class="downloads" data-registro-fontes>
        {
          ARQUIVOS.map((a) => (
            <li>
              <BotaoBaixar arquivo={a.nome} />
              <span class="cp-text-body-small ajuda">{a.descricao}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<script>
  import '../scripts/fontes-filtro';
</script>
