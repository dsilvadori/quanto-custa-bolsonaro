---
import { Callout, Link, SegmentedButton } from '@boralula/ui';
import Base from '../layouts/Base.astro';
import LinksSimulador from '../components/LinksSimulador.astro';
import { Fonte } from '../components/Fonte';
import { Resultados } from '../components/Resultados';
import { BarraCompartilhar } from '../components/BarraCompartilhar';
import { CESTA, DADOS_BENEFICIO, INPC_ANUAL, MINIMO_ATUAL, PARAMETROS, SALARIO_MINIMO } from '../dados';
import { valorNoMes } from '../calc/salarioMinimo';
import {
  estadoPadraoBeneficio,
  frasesBeneficio,
  graficoProjecao,
  graficoRetro,
  linhasProjecao,
  linhasRetro,
} from '../simuladores/beneficio';
import { pct, reais } from '../formato';
import { PAGINAS } from '../site';

const url = new URL(PAGINAS.aposentadoriaBpc.path, Astro.site).href;
const d = DADOS_BENEFICIO;
const e = estadoPadraoBeneficio(d);
const f = frasesBeneficio(d, e);
const fonteInpc = INPC_ANUAL[0].fonte;
const fonteHoje = MINIMO_ATUAL.fonte;
// Ponto de partida: mínimo de dezembro do ano-base e o ato que o fixou.
const valorBase = valorNoMes(d.real, d.anoBase, 12);
const fonteValorBase = SALARIO_MINIMO.filter((v) => v.inicio <= `${d.anoBase}-12-01`).at(-1)!.fonte;
const fonteGanho = PARAMETROS.ganho_real_min_pct.fonte;
const fonteCesta = CESTA.fonteValores;
const fontePeriodo = PARAMETROS.ganho_real_ate_ano.fonte;
const periodo = `${d.anoBase + 1} a ${d.anoAtual}`;
const futuro = `${d.anoAtual + 1} a ${d.ateAno}`;
const ancora = new URL(`${PAGINAS.fontes.path}#${fonteInpc}`, Astro.site);
const dados = JSON.stringify({ dados: d, urlFontes: ancora.host + ancora.pathname + ancora.hash }).replace(/</g, '\\u003c');
---

<Base
  id="aposentadoriaBpc"
  selo="Simulador"
  imagem={{ src: '/og/aposentadoria-bpc.png', alt: `Se o BPC tivesse sido desvinculado do mínimo em ${d.anoBase + 1}, hoje seria ${f.hoje}, e não ${reais(d.piso)}.` }}
>
  <p slot="lead" class="hero__lead cp-text-body-large">
    Hoje, o BPC e a aposentadoria de 1 salário mínimo sobem junto com o mínimo
    <span class="junto"><Fonte id="cf-1988-piso-beneficios" />.</span> Veja quanto valeriam se tivessem sido desvinculados dele e
    subissem só pela inflação.
  </p>

  <section class="secao" aria-label="O que foi noticiado">
    <div class="cp-container">
      <Callout title="E se a proposta estudada pela equipe de Flávio fosse aprovada?" headingLevel={2}>
        A Folha de S.Paulo noticiou em 7 de outubro de 2026 que a equipe do programa econômico de Flávio Bolsonaro estuda
        desvincular o reajuste da Previdência e do BPC dos ganhos reais do salário mínimo <Fonte id="folha-2026-10-07-plano-flavio" />.
        Em 8 de outubro, o candidato negou que vá fazer isso <Fonte id="poder360-2026-10-08-flavio-nega" />. As contas abaixo mostram o
        efeito se a proposta fosse aprovada.
      </Callout>
    </div>
  </section>

  <section class="secao secao--cinza" aria-labelledby="ultimos-anos">
    <div class="cp-container simulador">
      <form class="cartao simulador__form" id="form-simulador" data-numero>
        <h2 id="ultimos-anos" class="cp-text-h2">E se a desvinculação fosse em {d.anoBase + 1}?</h2>
        <p>
          O benefício partiria de {reais(valorBase)} em {d.anoBase} <Fonte id={fonteValorBase} /> e, a cada janeiro, subiria só pela
          inflação do ano anterior (INPC) <Fonte id={fonteInpc} />, como já acontece com quem ganha acima do piso
          <span class="junto"><Fonte id="lei-8213-art-41a-inpc" />.</span>
        </p>
        <fieldset class="campo-grupo so-com-js" data-segmentado="tipo">
          <legend class="cp-text-title">Qual benefício?</legend>
          <SegmentedButton
            label="Benefício"
            value="bpc"
            onChange={() => {}}
            options={[
              { value: 'bpc', label: 'BPC' },
              { value: 'aposentadoria', label: 'Aposentadoria' },
            ]}
          />
          <p class="cp-text-body-small ajuda"><span data-saida="pagamentos">{f.pagamentos}</span> <Fonte id="decreto-6214-2007-bpc-sem-abono" /></p>
        </fieldset>
      </form>

      <div class="cartao simulador__resultado" data-numero>
        <p class="cp-text-body-large resultado__frase" aria-live="polite" data-saida="retro">{f.retro}</p>
        <Resultados
          itens={[
            { saida: 'hoje', valor: f.hoje, rotulo: `seria o benefício em ${d.anoAtual}, e não ${reais(d.piso)}` },
            { saida: 'retroPorMes', valor: `−${f.retroPorMes}`, rotulo: 'por mês' },
            { saida: 'retroTotal', valor: `−${f.retroTotal}`, rotulo: `de ${periodo}` },
          ]}
        />
        <p class="cp-text-body-small">
          Mínimo de hoje <Fonte id={fonteHoje} /> e INPC de cada ano <span class="junto"><Fonte id={fonteInpc} />.</span>
          <Link href={PAGINAS.comoCalculamos.path}>Veja como calculamos</Link>
        </p>
      </div>
    </div>
  </section>

  <section class="secao" aria-labelledby="ano-a-ano">
    <div class="cp-container">
      <figure class="grafico-cartao" data-numero>
        <figcaption>
          <h2 id="ano-a-ano" class="cp-text-h2">Ano a ano, de {periodo}</h2>
          <ul class="legenda" aria-hidden="true">
            <li><span class="legenda__cor legenda__cor--lula"></span>Governo Lula (aumento acima da inflação)</li>
            <li><span class="legenda__cor legenda__cor--bolsonaro"></span>Proposta da equipe do Flávio</li>
          </ul>
        </figcaption>
        <div class="grafico-area" data-grafico="retro" set:html={graficoRetro(d, e)} />
        <p class="cp-text-body-small">
          Valor mensal em dezembro de cada ano. Mínimo <Fonte id={fonteHoje} /> e <span class="junto">INPC <Fonte id={fonteInpc} />.</span>
        </p>
        <details class="tabela-detalhes">
          <summary>Ver os números</summary>
          <div class="tabela-rolagem">
            <table class="tabela">
              <caption class="cp-visually-hidden">Benefício ligado ao mínimo e desvinculado, e perda em cada ano</caption>
              <thead>
                <tr>
                  <th scope="col">Ano</th><th scope="col">Ligado ao mínimo</th><th scope="col">Desvinculado</th><th scope="col">Perda por mês</th><th scope="col">Perda no ano</th>
                </tr>
              </thead>
              <tbody data-linhas="retro" set:html={linhasRetro(d, e)} />
            </table>
          </div>
        </details>
      </figure>
    </div>
  </section>

  <section class="secao secao--cinza" aria-labelledby="daqui-para-frente">
    <div class="cp-container">
      <div class="cartao" data-numero>
        <h2 id="daqui-para-frente" class="cp-text-h2">Daqui para a frente: o poder de compra sem aumento real</h2>
        <fieldset class="campo-grupo so-com-js">
          <legend id="ganho-rotulo" class="cp-text-title">Ganho real do salário mínimo por ano</legend>
          <div class="faixa">
            <input
              type="range"
              id="ganho"
              min={d.ganhoMin}
              max={d.ganhoMax}
              step="0.1"
              value={e.ganho}
              aria-labelledby="ganho-rotulo"
              aria-describedby="ganho-ajuda"
            />
            <output for="ganho" class="faixa__valor" data-saida="ganho">{pct(e.ganho, 1)}</output>
          </div>
          <p id="ganho-ajuda" class="cp-text-body-small ajuda">
            Pela lei, o ganho real do mínimo fica entre {pct(d.ganhoMin, 1)} e {pct(d.ganhoMax, 1)} ao ano
            <Fonte id={fonteGanho} />, regra válida até {d.ateAno} <span class="junto"><Fonte id={fontePeriodo} />.</span>
          </p>
        </fieldset>
        <p class="cp-text-body-large resultado__frase" aria-live="polite" data-saida="futuro">{f.futuro}</p>
        <Resultados
          itens={[
            { saida: 'perdaPct', valor: `−${f.perdaPct}`, rotulo: `de poder de compra em ${d.ateAno}` },
            { saida: 'cestasFinal', valor: f.cestasFinal, rotulo: `cestas básicas por mês em ${d.ateAno}` },
            { saida: 'cestasPerdidas', valor: `−${f.cestasPerdidas}`, rotulo: `cestas de ${futuro}` },
          ]}
        />
        <ul class="legenda" aria-hidden="true">
          <li><span class="legenda__cor legenda__cor--lula"></span>Regra do governo Lula (aumento acima da inflação)</li>
          <li><span class="legenda__cor legenda__cor--bolsonaro"></span>Proposta da equipe do Flávio</li>
        </ul>
        <div class="grafico-area" data-grafico="projecao" set:html={graficoProjecao(d, e)} />
        <p class="cp-text-body-small">
          Cestas básicas por mês, com a cesta subindo junto com a inflação. Piso de hoje <Fonte id={fonteHoje} /> e cesta média das
          capitais <span class="junto"><Fonte id={fonteCesta} />.</span>
        </p>
        <details class="tabela-detalhes">
          <summary>Ver os números</summary>
          <div class="tabela-rolagem">
            <table class="tabela">
              <caption class="cp-visually-hidden">Projeção do benefício em reais de hoje, poder de compra e cestas básicas por mês</caption>
              <thead>
                <tr>
                  <th scope="col">Ano</th><th scope="col">Ligado ao mínimo</th><th scope="col">Sem aumento real</th><th scope="col">Poder de compra</th><th scope="col">Cestas por mês</th><th scope="col">Perda no ano</th>
                </tr>
              </thead>
              <tbody data-linhas="projecao" set:html={linhasProjecao(d, e)} />
            </table>
          </div>
        </details>
      </div>
    </div>
  </section>

  <div class="cp-container">
    <BarraCompartilhar textoWhatsapp={f.whatsapp(url)} />
  </div>

  <div class="cp-container secao">
    <LinksSimulador atual="aposentadoriaBpc" />
  </div>

  <script slot="fim" type="application/json" id="dados-beneficio" set:html={dados} />
</Base>

<script>
  import '../scripts/sim-beneficio';
</script>
