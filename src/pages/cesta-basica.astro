---
import { Link, SegmentedButton, Stat } from '@boralula/ui';
import Base from '../layouts/Base.astro';
import LinksSimulador from '../components/LinksSimulador.astro';
import { Fonte } from '../components/Fonte';
import { Resultados } from '../components/Resultados';
import { BarraCompartilhar } from '../components/BarraCompartilhar';
import { CENARIO_SM, CESTA, DADOS_CESTA, MINIMO_ATUAL } from '../dados';
import { ESTADO_PADRAO_CESTA, MEDIA, frasesCesta, graficoCapitais, graficoCesta, graficoGovernos } from '../simuladores/cesta';
import { pct } from '../formato';
import { PAGINAS, dataPorExtenso } from '../site';

const url = new URL(PAGINAS.cestaBasica.path, Astro.site).href;
const d = DADOS_CESTA;
const e = ESTADO_PADRAO_CESTA;
const f = frasesCesta(d, e);
const inpcFinal = CENARIO_SM.inpc[CENARIO_SM.inpc.length - 1];
const mesReferencia = dataPorExtenso(`${CESTA.referencia}-01`).replace(/^1º de /, '');
const ancora = new URL(`${PAGINAS.fontes.path}#${CESTA.fonteValores}`, Astro.site);
const dados = JSON.stringify({ dados: d, urlFontes: ancora.host + ancora.pathname + ancora.hash }).replace(/</g, '\\u003c');
---

<Base
  id="cestaBasica"
  selo="Simulador"
  imagem={{ src: '/og/cesta-basica.png', alt: `A cesta básica custaria ${f.cenario} no ritmo do governo Bolsonaro, e não ${f.hoje}.` }}
>
  <Fragment slot="lead">
    <p class="hero__lead cp-text-body-large">
      Hoje, a cesta básica custa em média <span class="junto">{f.hoje} <Fonte id={CESTA.fonteValores} /></span> nas capitais. Se a
      comida subisse no ritmo do governo Bolsonaro, custaria <strong class="destaque">{f.cenario}</strong>.
    </p>
    <div class="hero__numero" data-numero>
      <Stat surface="red" value={`+${f.porMes}`} label="por mês na mesma cesta" />
      <p class="cp-text-body-small">
        Comida no domicílio pelo IPCA <Fonte id={CESTA.bolsonaro.fontes[0]} /> <Fonte id={CESTA.atual.fontes[0]} /> e valor da cesta
        em {mesReferencia} <span class="junto"><Fonte id={CESTA.fonteValores} />.</span>
      </p>
    </div>
  </Fragment>

  <section class="secao secao--cinza" aria-labelledby="calcule">
    <div class="cp-container simulador">
      <form class="cartao simulador__form" id="form-simulador" data-numero>
        <h2 id="calcule" class="cp-text-h2">Quanto a comida subiu</h2>
        <Resultados
          itens={[
            { saida: 'altaBolsonaro', valor: `+${pct(CESTA.bolsonaro.pct)}`, rotulo: `no governo Bolsonaro, em ${CESTA.bolsonaro.meses} meses` },
            { saida: 'altaAtual', valor: `+${pct(CESTA.atual.pct)}`, rotulo: `no governo Lula, em ${CESTA.atual.meses} meses (até ${mesReferencia})` },
          ]}
        />
        <div class="grafico-area" set:html={graficoGovernos(d)} />
        <p class="cp-text-body-small ajuda">
          Alimentação no domicílio, IPCA <Fonte id="ipca-alim-2019" /> <Fonte id="ipca-alim-2020-2022" />
          <span class="junto"><Fonte id="ipca-alim-2023-2026" />.</span>
        </p>
        <div class="campo so-com-js">
          <label for="capital" class="cp-text-title">Onde você mora?</label>
          <select id="capital" class="seletor">
            <option value={MEDIA}>Média das {d.capitais.length} capitais</option>
            {d.capitais.map((c) => <option value={c.nome}>{c.nome}</option>)}
          </select>
        </div>
        <fieldset class="campo-grupo so-com-js" data-segmentado="ritmo">
          <legend class="cp-text-title">E se a comida subisse em qual ritmo?</legend>
          <SegmentedButton
            label="Ritmo de alta da comida"
            value="100"
            onChange={() => {}}
            options={[
              { value: '100', label: '100%' },
              { value: '75', label: '75%' },
              { value: '50', label: '50%' },
            ]}
          />
          <p class="cp-text-body-small ajuda">Parte do ritmo mensal de alta do governo Bolsonaro.</p>
        </fieldset>
      </form>

      <div class="cartao simulador__resultado" data-numero>
        <p class="cp-text-body-large resultado__frase" aria-live="polite" data-saida="resumo">{f.resumo}</p>
        <Resultados
          itens={[
            { saida: 'cenario', valor: f.cenario, rotulo: 'a cesta no ritmo de Bolsonaro' },
            { saida: 'porMes', valor: `+${f.porMes}`, rotulo: 'a mais por mês' },
            { saida: 'porAno', valor: `+${f.porAno}`, rotulo: 'a mais em 12 meses' },
          ]}
        />
        <div class="grafico-area" data-grafico set:html={graficoCesta(d, e)} />
        <p class="cp-text-body" data-saida="pesoTexto">{f.pesoTexto}</p>
        <p class="cp-text-body-small">
          Valor da cesta <Fonte id={CESTA.fonteValores} />, mínimo de hoje <Fonte id={MINIMO_ATUAL.fonte} /> e mínimo só pela
          inflação <span class="junto"><Fonte id={inpcFinal.fonte} />.</span>
          <Link href={PAGINAS.comoCalculamos.path}>Veja como calculamos</Link>
        </p>
      </div>
    </div>
  </section>

  <section class="secao" aria-labelledby="capitais">
    <div class="cp-container">
      <figure class="grafico-cartao" data-numero>
        <figcaption>
          <h2 id="capitais" class="cp-text-h2">Na sua capital</h2>
          <p class="ajuda">Quanto a cesta custaria a mais por mês em cada capital, no ritmo de preços do governo Bolsonaro.</p>
        </figcaption>
        <div class="grafico-area grafico-area--largo" data-grafico="capitais" set:html={graficoCapitais(d, e)} />
        <p class="cp-text-body-small">
          Valor da cesta em cada capital <Fonte id={CESTA.fonteValores} /> e alta da comida no IPCA
          <span class="junto"><Fonte id="ipca-alim-2023-2026" />.</span>
        </p>
      </figure>
    </div>
  </section>

  <div class="cp-container secao">
    <LinksSimulador atual="cestaBasica" />
  </div>

  <BarraCompartilhar slot="fim" textoWhatsapp={f.whatsapp(url)} />
  <script slot="fim" type="application/json" id="dados-cesta" set:html={dados} />
</Base>

<script>
  import '../scripts/sim-cesta';
</script>
