---
import { Link, Stat, TextField } from '@boralula/ui';
import Base from '../layouts/Base.astro';
import LinksSimulador from '../components/LinksSimulador.astro';
import { Fonte } from '../components/Fonte';
import { BarraCompartilhar } from '../components/BarraCompartilhar';
import { Resultados } from '../components/Resultados';
import { COMBUSTIVEIS, PICO_COMBUSTIVEL } from '../dados';
import { fracaoFossil, repasse } from '../calc/combustivel';
import { APLICATIVO, NOMES, VEICULOS, calcularCombustivel, efeitoTotal, gastoMensal, graficoBomba, tanqueCheio } from '../simuladores/combustivel';
import { ICONE_VEICULO, Selo } from '../icones';
import { fonte } from '../fontes';
import { pct, preco, reais } from '../formato';
import { PAGINAS, dataPorExtenso } from '../site';

const url = new URL(PAGINAS.combustivel.path, Astro.site).href;
const linhas = COMBUSTIVEIS.map((c) => ({ ...c, r: calcularCombustivel(c) }));
const diesel = linhas.find((l) => l.combustivel === 'diesel')!;
const gasolina = linhas.find((l) => l.combustivel === 'gasolina')!;
const total = efeitoTotal(COMBUSTIVEIS);
// Pico de 2026 da gasolina: maior diferença nos relatórios da Abicom, com a mistura que valia na data.
const picos = PICO_COMBUSTIVEL.map((p) => {
  const aumento = repasse(p.defasagem, fracaoFossil(p.teorBio));
  return { ...p, aumento, tanque50: 50 * aumento, dataTexto: dataPorExtenso(p.data).replace(/ de \d{4}$/, '') };
});
const picoGasolina = picos.find((p) => p.combustivel === 'gasolina');
// Motorista de aplicativo (gasolina): gasto por mês com o exemplo de km e consumo.
const app = gastoMensal(gasolina, APLICATIVO.kmMesExemplo, APLICATIVO.kmPorLitroExemplo);
const appPico = picoGasolina ? app.litros * picoGasolina.aumento : null;
const dadosApp = JSON.stringify({ linha: { combustivel: gasolina.combustivel, defasagem: gasolina.defasagem, teorBio: gasolina.teorBio, preco: gasolina.preco, peso: gasolina.peso }, pico: picoGasolina?.aumento ?? null }).replace(/</g, '\\u003c');
const veiculos = VEICULOS.map((v) => {
  const l = linhas.find((x) => x.combustivel === v.combustivel)!;
  return { ...v, linha: l, t: tanqueCheio(l, v.litrosExemplo) };
});
const fonteAbicom = diesel.fontes.defasagem;
const dataAbicom = dataPorExtenso(fonte(fonteAbicom).data_publicacao!);
const ppx = (v: number) => `${v.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} ponto percentual`;

const whatsapp = `Se a Petrobras voltasse a seguir o preço de importação, como no governo Bolsonaro, o diesel subiria ${reais(diesel.r.aumento)} e a gasolina ${reais(gasolina.r.aumento)} por litro. Veja a conta e as fontes: ${url}`;
const ancora = new URL(`${PAGINAS.fontes.path}#${fonteAbicom}`, Astro.site);
const tanques = JSON.stringify(
  veiculos.map((v) => ({ id: v.id, linha: { combustivel: v.linha.combustivel, defasagem: v.linha.defasagem, teorBio: v.linha.teorBio, preco: v.linha.preco, peso: v.linha.peso } })),
).replace(/</g, '\\u003c');
const compartilhar = JSON.stringify({
  texto: whatsapp,
  url,
  cartao: {
    numero: `+${reais(diesel.r.aumento)}`,
    linha: 'no litro do diesel, e ' + `+${reais(gasolina.r.aumento)} no da gasolina`,
    premissa: `Se a Petrobras voltasse a seguir o preço de importação (PPI), pela diferença nos polos da Petrobras calculada pela Abicom em ${dataAbicom}.`,
    fonte: 'Fontes: Abicom, ANP, CNPE e IBGE',
    url: ancora.host + ancora.pathname + ancora.hash,
  },
}).replace(/</g, '\\u003c');
---

<Base
  id="combustivel"
  selo="Simulador"
  imagem={{ src: '/og/combustivel.png', alt: `Com o preço de importação, o diesel subiria ${reais(diesel.r.aumento)} e a gasolina ${reais(gasolina.r.aumento)} por litro.` }}
>
  <Fragment slot="lead">
    <p class="hero__lead cp-text-body-large">
      Até maio de 2023, a Petrobras seguia o preço de importação (PPI), regra usada no governo Bolsonaro
      <span class="junto"><Fonte id="petrobras-2023-05-16-fim-ppi" />.</span> Se voltasse a seguir, o diesel subiria
      <strong class="destaque">{reais(diesel.r.aumento)}</strong> por litro e a gasolina,
      <strong class="destaque">{reais(gasolina.r.aumento)}</strong>.
    </p>
    <div class="hero__numero" data-numero>
      <Stat surface="red" value={`+${reais(diesel.r.aumento)}`} label="no litro do diesel" />
      {
        picoGasolina && (
          <p class="cp-text-body-small">
            No pico de 2026, em {picoGasolina.dataTexto}, a gasolina subiria <strong class="destaque">{reais(picoGasolina.aumento)}</strong>
            por litro <Fonte id={picoGasolina.fontes.defasagem} /> <span class="junto"><Fonte id={picoGasolina.fontes.teor} />.</span>
          </p>
        )
      }
      <p class="cp-text-body-small">
        Diferença para o preço de importação nos polos da Petrobras em {dataAbicom} <Fonte id={fonteAbicom} />, só na parte de petróleo do litro
        <Fonte id={diesel.fontes.teor} /> <span class="junto"><Fonte id={gasolina.fontes.teor} />.</span>
      </p>
    </div>
  </Fragment>

  <section class="secao secao--cinza" aria-labelledby="conta">
    <div class="cp-container">
      <h2 id="conta" class="cp-text-h2">A conta, litro a litro</h2>
      <figure class="grafico-cartao cartao" data-numero>
        <figcaption>
          <ul class="legenda" aria-hidden="true">
            <li><span class="legenda__cor legenda__cor--lula"></span>Governo Lula (hoje)</li>
            <li><span class="legenda__cor legenda__cor--bolsonaro"></span>PPI do governo do Bolsonaro</li>
          </ul>
        </figcaption>
        <div class="grafico-area" set:html={graficoBomba(COMBUSTIVEIS)} />
        <p class="cp-text-body-small">
          Preço no governo Lula (hoje) <Fonte id={diesel.fontes.preco} /> mais o aumento com o PPI <span class="junto"><Fonte id={fonteAbicom} />.</span>
        </p>
      </figure>
      <div class="grade-combustivel">
        {
          [diesel, gasolina].map((l) => (
            <div class="cartao" data-numero>
              <h3 class="cp-text-h3">{NOMES[l.combustivel]}</h3>
              <dl class="conta">
                <dt>Diferença para o preço de importação (polos da Petrobras)</dt>
                <dd>
                  {reais(l.defasagem)} <Fonte id={l.fontes.defasagem} />
                </dd>
                <dt>Parte de petróleo no litro</dt>
                <dd>
                  {pct(100 - l.teorBio, 0)} <Fonte id={l.fontes.teor} />
                </dd>
                <dt>Aumento na bomba</dt>
                <dd class="conta__destaque">+{reais(l.r.aumento)}</dd>
                <dt>Preço no governo Lula (hoje)</dt>
                <dd>
                  {reais(l.preco)} <Fonte id={l.fontes.preco} />
                </dd>
                <dt>Preço com o PPI do governo do Bolsonaro</dt>
                <dd class="conta__destaque">{reais(l.r.novoPreco)}</dd>
                <dt>Alta</dt>
                <dd>+{pct(l.r.alta, 1)}</dd>
                <dt>Efeito direto na inflação (IPCA)</dt>
                <dd>
                  +{ppx(l.r.efeito)} <Fonte id={l.fontes.peso} />
                </dd>
              </dl>
            </div>
          ))
        }
      </div>
      {
        picos.map((p) => (
          <div class="cartao conta__pico" data-numero>
            <h3 class="cp-text-h3">Pico de 2026: {NOMES[p.combustivel].toLowerCase()} em {p.dataTexto}</h3>
            <p class="cp-text-body-large resultado__frase">
              Nos polos da Petrobras, a diferença para o preço de importação chegou a {reais(p.defasagem)} por litro
              <span class="junto"><Fonte id={p.fontes.defasagem} />.</span> Com a mistura de {pct(p.teorBio, 0)} de etanol da época
              <span class="junto"><Fonte id={p.fontes.teor} />,</span> o PPI daria <strong>{reais(p.aumento)} a mais por litro</strong> na
              bomba: {reais(p.tanque50)} a mais num tanque de 50 litros.
            </p>
            <p class="cp-text-body-small ajuda">
              É o maior valor dos relatórios diários da Abicom em 2026. A diferença muda todo dia com o preço do petróleo e o dólar.
            </p>
          </div>
        ))
      }
      <div class="cartao conta__total" data-numero>
        <p class="cp-text-body-large resultado__frase">
          Só a gasolina e o diesel somariam <span class="junto">+{ppx(total)}</span> à inflação do mês, sem contar o efeito no
          frete e nos preços de outros produtos.
        </p>
        <p class="cp-text-body-small">
          Alta de cada combustível × peso dele no IPCA <span class="junto"><Fonte id={diesel.fontes.peso} />.</span> ICMS e
          PIS/Cofins são cobrados por litro e não mudam com o preço.
          <Link href={PAGINAS.comoCalculamos.path}>Veja como calculamos</Link>
        </p>
      </div>
    </div>
  </section>

  <section class="secao" aria-labelledby="tanque">
    <div class="cp-container">
      <h2 id="tanque" class="cp-text-h2">Quanto custaria encher o tanque?</h2>
      <form class="grade-combustivel" id="form-simulador">
        {
          veiculos.map((v) => (
            <div class="cartao" data-numero data-veiculo={v.id}>
              <h3 class="cp-text-h3 card-titulo"><Selo icone={ICONE_VEICULO[v.id]} />{v.nome}</h3>
              <TextField
                id={`litros-${v.id}`}
                label={`Tamanho do tanque (litros de ${v.combustivel === 'diesel' ? 'diesel S10' : 'gasolina'})`}
                inputMode="numeric"
                autoComplete="off"
                defaultValue={String(v.litrosExemplo)}
                helperText={`Exemplo: ${v.litrosExemplo} litros. Mude para o tamanho do seu tanque.`}
                className="so-com-js"
              />
              <p class="cp-text-body-large resultado__frase" aria-live="polite">
                <span data-saida={`frase-${v.id}`}>
                  Tanque de {v.litrosExemplo} litros: {preco(v.t.hoje)} no governo Lula e {preco(v.t.comPpi)} com o PPI do governo do Bolsonaro.
                </span>
              </p>
              <Resultados
                itens={[
                  { saida: `hoje-${v.id}`, valor: preco(v.t.hoje), rotulo: 'o tanque cheio no governo Lula (hoje)' },
                  { saida: `ppi-${v.id}`, valor: preco(v.t.comPpi), rotulo: 'com o PPI do governo do Bolsonaro' },
                  { saida: `dif-${v.id}`, valor: `+${preco(v.t.diferenca)}`, rotulo: 'a mais por tanque' },
                ]}
              />
              <p class="cp-text-body-small">
                Preço no governo Lula (hoje) <Fonte id={v.linha.fontes.preco} /> mais o aumento por litro com o PPI
                <span class="junto"><Fonte id={v.linha.fontes.defasagem} />.</span>
              </p>
            </div>
          ))
        }
      </form>
    </div>
  </section>

  <section class="secao secao--cinza" aria-labelledby="aplicativo">
    <div class="cp-container simulador">
      <div class="cartao simulador__form">
        <h2 id="aplicativo" class="cp-text-h2 card-titulo"><Selo icone={ICONE_VEICULO.carro} />Motorista de aplicativo: gasto por mês</h2>
        <TextField
          id="km-mes"
          label="Quantos km você roda por mês?"
          inputMode="numeric"
          autoComplete="off"
          defaultValue={APLICATIVO.kmMesExemplo.toLocaleString('pt-BR')}
          helperText={`Exemplo: ${APLICATIVO.kmMesExemplo.toLocaleString('pt-BR')} km (cerca de 200 km por dia, 25 dias). Mude para o seu.`}
          className="so-com-js"
        />
        <TextField
          id="km-litro"
          label="Quantos km o carro faz por litro de gasolina?"
          inputMode="decimal"
          autoComplete="off"
          defaultValue={String(APLICATIVO.kmPorLitroExemplo)}
          helperText={`Exemplo: ${APLICATIVO.kmPorLitroExemplo} km por litro. Mude para o do seu carro.`}
          className="so-com-js"
        />
      </div>
      <div class="cartao simulador__resultado" data-numero>
        <p class="cp-text-body-large resultado__frase" aria-live="polite" data-saida="app-frase">
          Rodando {APLICATIVO.kmMesExemplo.toLocaleString('pt-BR')} km por mês a {APLICATIVO.kmPorLitroExemplo} km por litro, são
          {app.litros.toLocaleString('pt-BR', { maximumFractionDigits: 0 })} litros de gasolina: {preco(app.hoje)} no governo Lula e
          {preco(app.comPpi)} com o PPI do governo do Bolsonaro.
        </p>
        <Resultados
          itens={[
            { saida: 'app-dif', valor: `+${preco(app.diferenca)}`, rotulo: 'a mais por mês' },
            { saida: 'app-ano', valor: `+${preco(app.porAno)}`, rotulo: 'a mais em 12 meses' },
            { saida: 'app-ppi', valor: preco(app.comPpi), rotulo: 'por mês com o PPI' },
          ]}
        />
        {
          appPico !== null && picoGasolina && (
            <p class="cp-text-body">
              No pico de 2026, em {picoGasolina.dataTexto}, seriam <strong class="conta__destaque" data-saida="app-pico">+{preco(appPico)}</strong>
              por mês <Fonte id={picoGasolina.fontes.defasagem} /> <span class="junto"><Fonte id={picoGasolina.fontes.teor} />.</span>
            </p>
          )
        }
        <p class="cp-text-body-small">
          Preço da gasolina no governo Lula (hoje) <Fonte id={gasolina.fontes.preco} /> mais o aumento por litro com o PPI
          <span class="junto"><Fonte id={gasolina.fontes.defasagem} />.</span>
        </p>
      </div>
    </div>
  </section>

  <div class="cp-container">
    <BarraCompartilhar textoWhatsapp={whatsapp} />
  </div>

  <div class="cp-container secao">
    <LinksSimulador atual="combustivel" />
  </div>

  <script slot="fim" type="application/json" id="dados-combustivel" set:html={compartilhar} />
  <script slot="fim" type="application/json" id="dados-tanques" set:html={tanques} />
  <script slot="fim" type="application/json" id="dados-aplicativo" set:html={dadosApp} />
</Base>

<script>
  import '../scripts/sim-combustivel';
</script>
