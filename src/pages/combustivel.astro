---
import { Link, Stat, TextField } from '@boralula/ui';
import Base from '../layouts/Base.astro';
import LinksSimulador from '../components/LinksSimulador.astro';
import { Fonte } from '../components/Fonte';
import { BarraCompartilhar } from '../components/BarraCompartilhar';
import { Resultados } from '../components/Resultados';
import { COMBUSTIVEIS } from '../dados';
import { NOMES, VEICULOS, calcularCombustivel, efeitoTotal, graficoBomba, tanqueCheio } from '../simuladores/combustivel';
import { ICONE_VEICULO, Selo } from '../icones';
import { fonte } from '../fontes';
import { pct, preco, reais } from '../formato';
import { PAGINAS, dataPorExtenso } from '../site';

const url = new URL(PAGINAS.combustivel.path, Astro.site).href;
const linhas = COMBUSTIVEIS.map((c) => ({ ...c, r: calcularCombustivel(c) }));
const diesel = linhas.find((l) => l.combustivel === 'diesel')!;
const gasolina = linhas.find((l) => l.combustivel === 'gasolina')!;
const total = efeitoTotal(COMBUSTIVEIS);
const veiculos = VEICULOS.map((v) => {
  const l = linhas.find((x) => x.combustivel === v.combustivel)!;
  return { ...v, linha: l, t: tanqueCheio(l, v.litrosExemplo) };
});
const fonteAbicom = diesel.fontes.defasagem;
const dataAbicom = dataPorExtenso(fonte(fonteAbicom).data_publicacao!);
const ppx = (v: number) => `${v.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} ponto percentual`;

const whatsapp = `Se a Petrobras voltasse a seguir o preço de importação, como no governo Bolsonaro, o diesel subiria ${reais(diesel.r.aumento)} e a gasolina ${reais(gasolina.r.aumento)} por litro. Veja a conta e as fontes: ${url}`;
const ancora = new URL(`${PAGINAS.fontes.path}#${fonteAbicom}`, Astro.site);
const tanques = JSON.stringify(
  veiculos.map((v) => ({ id: v.id, linha: { combustivel: v.linha.combustivel, defasagem: v.linha.defasagem, teorBio: v.linha.teorBio, preco: v.linha.preco, peso: v.linha.peso } })),
).replace(/</g, '\\u003c');
const compartilhar = JSON.stringify({
  texto: whatsapp,
  url,
  cartao: {
    numero: `+${reais(diesel.r.aumento)}`,
    linha: 'no litro do diesel, e ' + `+${reais(gasolina.r.aumento)} no da gasolina`,
    premissa: `Se a Petrobras voltasse a seguir o preço de importação (PPI), pelo cálculo da Abicom de ${dataAbicom}.`,
    fonte: 'Fontes: Abicom, ANP, CNPE e IBGE',
    url: ancora.host + ancora.pathname + ancora.hash,
  },
}).replace(/</g, '\\u003c');
---

<Base
  id="combustivel"
  selo="Simulador"
  imagem={{ src: '/og/combustivel.png', alt: `Com o preço de importação, o diesel subiria ${reais(diesel.r.aumento)} e a gasolina ${reais(gasolina.r.aumento)} por litro.` }}
>
  <Fragment slot="lead">
    <p class="hero__lead cp-text-body-large">
      Até maio de 2023, a Petrobras seguia o preço de importação (PPI), regra usada no governo Bolsonaro
      <span class="junto"><Fonte id="petrobras-2023-05-16-fim-ppi" />.</span> Se voltasse a seguir, o diesel subiria
      <strong class="destaque">{reais(diesel.r.aumento)}</strong> por litro e a gasolina,
      <strong class="destaque">{reais(gasolina.r.aumento)}</strong>.
    </p>
    <div class="hero__numero" data-numero>
      <Stat surface="red" value={`+${reais(diesel.r.aumento)}`} label="no litro do diesel" />
      <p class="cp-text-body-small">
        Diferença para o preço de importação em {dataAbicom} <Fonte id={fonteAbicom} />, só na parte de petróleo do litro
        <Fonte id={diesel.fontes.teor} /> <span class="junto"><Fonte id={gasolina.fontes.teor} />.</span>
      </p>
    </div>
  </Fragment>

  <section class="secao secao--cinza" aria-labelledby="conta">
    <div class="cp-container">
      <h2 id="conta" class="cp-text-h2">A conta, litro a litro</h2>
      <figure class="grafico-cartao cartao" data-numero>
        <figcaption>
          <ul class="legenda" aria-hidden="true">
            <li><span class="legenda__cor legenda__cor--cenario"></span>Hoje</li>
            <li><span class="legenda__cor legenda__cor--real"></span>Com o PPI</li>
          </ul>
        </figcaption>
        <div class="grafico-area" set:html={graficoBomba(COMBUSTIVEIS)} />
        <p class="cp-text-body-small">
          Preço médio hoje <Fonte id={diesel.fontes.preco} /> mais o aumento com o PPI <span class="junto"><Fonte id={fonteAbicom} />.</span>
        </p>
      </figure>
      <div class="grade-combustivel">
        {
          [diesel, gasolina].map((l) => (
            <div class="cartao" data-numero>
              <h3 class="cp-text-h3">{NOMES[l.combustivel]}</h3>
              <dl class="conta">
                <dt>Diferença para o preço de importação</dt>
                <dd>
                  {reais(l.defasagem)} <Fonte id={l.fontes.defasagem} />
                </dd>
                <dt>Parte de petróleo no litro</dt>
                <dd>
                  {pct(100 - l.teorBio, 0)} <Fonte id={l.fontes.teor} />
                </dd>
                <dt>Aumento na bomba</dt>
                <dd class="conta__destaque">+{reais(l.r.aumento)}</dd>
                <dt>Preço médio hoje</dt>
                <dd>
                  {reais(l.preco)} <Fonte id={l.fontes.preco} />
                </dd>
                <dt>Preço com o PPI</dt>
                <dd class="conta__destaque">{reais(l.r.novoPreco)}</dd>
                <dt>Alta</dt>
                <dd>+{pct(l.r.alta, 1)}</dd>
                <dt>Efeito direto na inflação (IPCA)</dt>
                <dd>
                  +{ppx(l.r.efeito)} <Fonte id={l.fontes.peso} />
                </dd>
              </dl>
            </div>
          ))
        }
      </div>
      <div class="cartao conta__total" data-numero>
        <p class="cp-text-body-large resultado__frase">
          Só a gasolina e o diesel somariam <span class="junto">+{ppx(total)}</span> à inflação do mês, sem contar o efeito no
          frete e nos preços de outros produtos.
        </p>
        <p class="cp-text-body-small">
          Alta de cada combustível × peso dele no IPCA <span class="junto"><Fonte id={diesel.fontes.peso} />.</span> ICMS e
          PIS/Cofins são cobrados por litro e não mudam com o preço.
          <Link href={PAGINAS.comoCalculamos.path}>Veja como calculamos</Link>
        </p>
      </div>
    </div>
  </section>

  <section class="secao" aria-labelledby="tanque">
    <div class="cp-container">
      <h2 id="tanque" class="cp-text-h2">Quanto custaria encher o tanque?</h2>
      <form class="grade-combustivel" id="form-simulador">
        {
          veiculos.map((v) => (
            <div class="cartao" data-numero data-veiculo={v.id}>
              <h3 class="cp-text-h3 card-titulo"><Selo icone={ICONE_VEICULO[v.id]} />{v.nome}</h3>
              <TextField
                id={`litros-${v.id}`}
                label={`Tamanho do tanque (litros de ${v.combustivel === 'diesel' ? 'diesel S10' : 'gasolina'})`}
                inputMode="numeric"
                autoComplete="off"
                defaultValue={String(v.litrosExemplo)}
                helperText={`Exemplo: ${v.litrosExemplo} litros. Mude para o tamanho do seu tanque.`}
                className="so-com-js"
              />
              <p class="cp-text-body-large resultado__frase" aria-live="polite">
                <span data-saida={`frase-${v.id}`}>
                  Tanque de {v.litrosExemplo} litros: {preco(v.t.hoje)} hoje e {preco(v.t.comPpi)} com o PPI.
                </span>
              </p>
              <Resultados
                itens={[
                  { saida: `hoje-${v.id}`, valor: preco(v.t.hoje), rotulo: 'o tanque cheio hoje' },
                  { saida: `ppi-${v.id}`, valor: preco(v.t.comPpi), rotulo: 'com o PPI' },
                  { saida: `dif-${v.id}`, valor: `+${preco(v.t.diferenca)}`, rotulo: 'a mais por tanque' },
                ]}
              />
              <p class="cp-text-body-small">
                Preço médio hoje <Fonte id={v.linha.fontes.preco} /> mais o aumento por litro com o PPI
                <span class="junto"><Fonte id={v.linha.fontes.defasagem} />.</span>
              </p>
            </div>
          ))
        }
      </form>
    </div>
  </section>

  <div class="cp-container secao">
    <LinksSimulador atual="combustivel" />
  </div>

  <BarraCompartilhar slot="fim" textoWhatsapp={whatsapp} />
  <script slot="fim" type="application/json" id="dados-combustivel" set:html={compartilhar} />
  <script slot="fim" type="application/json" id="dados-tanques" set:html={tanques} />
</Base>

<script>
  import '../scripts/sim-combustivel';
</script>
