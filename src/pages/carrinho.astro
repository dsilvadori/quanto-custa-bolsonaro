---
import { Link, Stat } from '@boralula/ui';
import Base from '../layouts/Base.astro';
import MapaDaFome from '../components/MapaDaFome.astro';
import PoliticasBolsonaro from '../components/PoliticasBolsonaro.astro';
import LinksSimulador from '../components/LinksSimulador.astro';
import { Fonte } from '../components/Fonte';
import { Resultados } from '../components/Resultados';
import { ListaCarrinho } from '../components/ListaCarrinho';
import { BotaoAtalho } from '../components/BotaoAtalho';
import { BarraCompartilhar } from '../components/BarraCompartilhar';
import { CARRINHO, DADOS_CARRINHO } from '../dados';
import { MEDIA, calcularCarrinho, estadoPadraoCarrinho, estadoVazio, frasesCarrinho, graficoProdutos, textoReferencia } from '../simuladores/carrinho';
import { PAGINAS, dataPorExtenso, link } from '../site';

const url = new URL(link(PAGINAS.carrinho.path), Astro.site).href;
const d = DADOS_CARRINHO;
// Topo: a compra da quinzena de uma família de 4. O carrinho em si começa vazio para a pessoa montar o seu.
const e = estadoPadraoCarrinho(d);
const f = frasesCarrinho(d, e);
const inicio = estadoVazio(d, MEDIA);
const r = calcularCarrinho(d, inicio);
const fInicio = frasesCarrinho(d, inicio);
const [fonte2019, fonteDepois] = [CARRINHO.fontesSubitens.find((id) => id.endsWith('2019'))!, CARRINHO.fontesSubitens.find((id) => !id.endsWith('2019'))!];
const [fonteDieese, fonteAnp] = [CARRINHO.fontesPreco.find((id) => id.startsWith('dieese'))!, CARRINHO.fontesPreco.find((id) => id.startsWith('anp'))!];
const mesReferencia = dataPorExtenso(`${CARRINHO.referencia}-01`).replace(/^1º de /, '');
const ancora = new URL(link(`${PAGINAS.fontes.path}#${fonteDieese}`), Astro.site);
const dados = JSON.stringify({ dados: d, urlFontes: ancora.host + ancora.pathname + ancora.hash }).replace(/</g, '\\u003c');
---

<Base
  id="carrinho"
  selo="Simulador"
  imagem={{ src: '/og/carrinho.png', alt: `A compra da quinzena de uma família de 4 pessoas custa ${f.hoje} hoje e custaria ${f.cenario} no governo do Bolsonaro.` }}
>
  <Fragment slot="lead">
    <p class="hero__lead cp-text-body-large">
      A compra da quinzena de uma família de 4 pessoas, com 2 adultos e 2 crianças <Fonte id={CARRINHO.fonteQtd} />, custa
      <span class="junto">{f.hoje} <Fonte id={fonteDieese} /></span> na média das capitais. Se cada produto tivesse subido como no governo do Bolsonaro, custaria
      <strong class="destaque">{f.cenario}</strong>.
    </p>
    <div class="hero__numero" data-numero>
      <Stat surface="red" value={f.diferenca} label="na compra da quinzena" />
      <p class="cp-text-body-small">
        Preços de {mesReferencia} <Fonte id={fonteDieese} /> e alta de cada produto no IPCA <Fonte id={fonte2019} />
        <span class="junto"><Fonte id={fonteDepois} />.</span>
      </p>
    </div>
  </Fragment>

  <section class="secao secao--cinza" aria-labelledby="monte">
    <div class="cp-container">
      <form class="cartao carrinho-cartao" id="form-simulador" data-numero>
        <h2 id="monte" class="cp-text-h2">Monte o seu carrinho de supermercado</h2>
        <p class="ajuda cp-text-body-small">
          Cada preço sobe no ritmo do próprio produto: a alta de {d.mesesBolsonaro} meses do governo Bolsonaro, aplicada aos
          {d.mesesAtual} meses desde janeiro de 2023, no lugar da alta real <Fonte id={fonte2019} />
          <span class="junto"><Fonte id={fonteDepois} />.</span> Gás de botijão: preço médio no Brasil
          <span class="junto"><Fonte id={fonteAnp} />.</span>
        </p>
        <p class="ajuda cp-text-body-small">
          Monte o seu carrinho com − e +. Se preferir, comece pela compra da quinzena ou do mês de uma família de 4 pessoas: é como o
          DIEESE conta o mês de 2 adultos e 2 crianças (3 cestas de adulto da sua capital), em quantidades redondas. Na tabela do
          DIEESE, o tomate representa todos os legumes e a banana, as frutas
          <span class="junto"><Fonte id={CARRINHO.fonteQtd} />.</span>
        </p>
        <div class="atalhos so-com-js">
          <BotaoAtalho acao="quinzena">Compra da quinzena</BotaoAtalho>
          <BotaoAtalho acao="mes">Compra do mês</BotaoAtalho>
          <BotaoAtalho acao="vazio">Esvaziar carrinho</BotaoAtalho>
        </div>
        <div class="campo so-com-js">
          <label for="capital" class="cp-text-title">Onde você mora?</label>
          <select id="capital" class="seletor">
            <option value={MEDIA}>Média das {d.capitais.length} capitais</option>
            {d.capitais.map((c) => <option value={c}>{c}</option>)}
          </select>
        </div>
        <ListaCarrinho linhas={r.linhas} fonteSubitem={fonteDepois} />
      </form>

      <div class="cartao simulador__resultado carrinho-total" data-numero>
        <h2 class="cp-text-h2">Total do carrinho</h2>
        <p class="cp-text-body-large resultado__frase" aria-live="polite" data-saida="resumo">{fInicio.resumo}</p>
        <Resultados
          itens={[
            { saida: 'hoje', valor: fInicio.hoje, rotulo: 'no governo Lula (hoje)' },
            { saida: 'cenario', valor: fInicio.cenario, rotulo: 'no governo do Bolsonaro' },
            { saida: 'diferenca', valor: `${fInicio.diferenca} (${fInicio.pct})`, rotulo: 'de diferença' },
          ]}
        />
        <p class="cp-text-body-small">
          Preços <Fonte id={fonteDieese} /> <Fonte id={fonteAnp} /> e IPCA <Fonte id={fonte2019} />
          <span class="junto"><Fonte id={fonteDepois} />.</span>
          <Link href={link(PAGINAS.comoCalculamos.path)}>Veja como calculamos</Link>
        </p>
      </div>
    </div>
  </section>

  <section class="secao" aria-labelledby="por-produto">
    <div class="cp-container">
      <figure class="grafico-cartao" data-numero>
        <figcaption>
          <h2 id="por-produto" class="cp-text-h2">Quanto cada produto mudaria de preço</h2>
          <p class="ajuda">Preço médio nas capitais no governo Lula (hoje) e como seria no governo do Bolsonaro.</p>
        </figcaption>
        <div class="grafico-area grafico-area--largo" set:html={graficoProdutos(d)} />
        <p class="cp-text-body-small">
          Alta de cada produto no IPCA <Fonte id={fonte2019} /> <span class="junto"><Fonte id={fonteDepois} />.</span>
        </p>
      </figure>
    </div>
  </section>

  <PoliticasBolsonaro cinza />

  <MapaDaFome />

  <div class="cp-container">
    <BarraCompartilhar textoWhatsapp={textoReferencia(d, MEDIA, url)} />
  </div>

  <div class="cp-container secao">
    <LinksSimulador atual="carrinho" />
  </div>

  <script slot="fim" type="application/json" id="dados-carrinho" set:html={dados} />
</Base>

<script>
  import '../scripts/sim-carrinho';
</script>
