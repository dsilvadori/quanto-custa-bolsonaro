---
import { Stat } from '@boralula/ui';
import Base from '../layouts/Base.astro';
import { CardsSimuladores } from '../components/CardsSimuladores';
import { Fonte } from '../components/Fonte';
import { CENARIO_SM, DADOS_SALARIO, MINIMO_ATUAL } from '../dados';
import { ESTADO_PADRAO, calcularSalario } from '../simuladores/salario';
import { reais } from '../formato';
import { PAGINAS, SITE } from '../site';

const url = new URL('/', Astro.site).href;
const r = calcularSalario(DADOS_SALARIO, ESTADO_PADRAO);
const inpcFinal = CENARIO_SM.inpc[CENARIO_SM.inpc.length - 1];
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.nome,
    url,
    inLanguage: 'pt-BR',
    description: PAGINAS.inicio.descricao,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    // TODO: dados de "Quem somos" quando os placeholders forem preenchidos.
    name: SITE.nome,
    url,
  },
];
---

<Base id="inicio" jsonLd={jsonLd} imagem={{ src: '/og/inicio.png', alt: PAGINAS.inicio.titulo }}>
  <Fragment slot="lead">
    <p class="hero__lead cp-text-body-large">
      Veja em reais o que mudaria no seu orçamento se as regras econômicas de 2019 a 2022 voltassem. Cada número tem fonte
      oficial.
    </p>
    <div class="hero__numero" data-numero>
      <Stat surface="red" value={reais(r.porMes)} label={`a menos por mês no salário mínimo de ${r.ultimo.ano}`} />
      <p class="cp-text-body-small">
        Se o mínimo seguisse só a inflação, seria {reais(r.ultimo.cenario)} <Fonte id={inpcFinal.fonte} />, e não
        <span class="junto">{reais(r.ultimo.real)} <Fonte id={MINIMO_ATUAL.fonte} />.</span>
      </p>
    </div>
  </Fragment>

  <section class="secao secao--cinza" aria-labelledby="simuladores">
    <div class="cp-container">
      <h2 id="simuladores" class="cp-text-h2">Escolha um simulador</h2>
      <CardsSimuladores headingLevel={3} />
    </div>
  </section>
</Base>
