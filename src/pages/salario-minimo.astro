---
import { Link, Stat, TextField } from '@boralula/ui';
import Base from '../layouts/Base.astro';
import LinksSimulador from '../components/LinksSimulador.astro';
import { Fonte } from '../components/Fonte';
import { Resultados } from '../components/Resultados';
import { BarraCompartilhar } from '../components/BarraCompartilhar';
import { CENARIO_SM, DADOS_SALARIO, INPC, MINIMO_ATUAL, SALARIO_MINIMO, SALARIO_MINIMO_REAL } from '../dados';
import {
  frasesHistorico,
  graficoAnoAAno,
  graficoGovernos,
  graficoPerdaBolsonaro,
  mesesDoGrafico,
  pctComSinal,
  perdaBolsonaro,
  reaisComSinal,
} from '../simuladores/historico';
import { ESTADO_PADRAO, calcularSalario, frasesSalario, graficoSalario } from '../simuladores/salario';
import { pct, reais } from '../formato';
import { PAGINAS, link } from '../site';

const pagina = PAGINAS.salarioMinimo;
const url = new URL(link(pagina.path), Astro.site).href;
const r = calcularSalario(DADOS_SALARIO, ESTADO_PADRAO);
const f = frasesSalario(DADOS_SALARIO, ESTADO_PADRAO);
const { padrao } = CENARIO_SM.bases;
const inpcFinal = CENARIO_SM.inpc[CENARIO_SM.inpc.length - 1];
const h = frasesHistorico(SALARIO_MINIMO_REAL);
const pb = perdaBolsonaro(SALARIO_MINIMO_REAL);
const fonteHistorico = SALARIO_MINIMO_REAL[0].fonte;
/** "2026-09" → "setembro de 2026" no texto e "set/2026" na tabela. */
const MESES = ['janeiro', 'fevereiro', 'março', 'abril', 'maio', 'junho', 'julho', 'agosto', 'setembro', 'outubro', 'novembro', 'dezembro'];
const ultimoMes = SALARIO_MINIMO_REAL.reduce((a, b) => (b.referencia > a.referencia ? b : a)).referencia;
const mesPorExtenso = (ref: string) => `${MESES[Number(ref.slice(5)) - 1]} de ${ref.slice(0, 4)}`;
const mesFinal = mesPorExtenso(ultimoMes);
const mesAno = (ref: string) => `${MESES[Number(ref.slice(5)) - 1].slice(0, 3)}/${ref.slice(0, 4)}`;

/** Fonte do valor em vigor em dezembro do ano (o 13º usa esse valor). */
const fonteDezembro = (ano: number) => SALARIO_MINIMO.filter((v) => v.inicio <= `${ano}-12-01`).at(-1)!.fonte;
const fonteInpc = (ano: number) => INPC.find((i) => i.aplicadoNoMinimoDe === ano)!.fonte;
const ancoraCartao = new URL(link(`${PAGINAS.fontes.path}#${MINIMO_ATUAL.fonte}`), Astro.site);
const dados = JSON.stringify({
  dados: DADOS_SALARIO,
  urlFontes: ancoraCartao.host + ancoraCartao.pathname + ancoraCartao.hash,
}).replace(/</g, '\\u003c');
---

<Base
  id="salarioMinimo"
  selo="Simulador"
  imagem={{ src: '/og/salario-minimo.png', alt: `O mínimo de ${r.ultimo.ano} seria ${reais(r.ultimo.cenario)} com a regra só pela inflação, e não ${reais(r.ultimo.real)}.` }}
>
  <Fragment slot="lead">
    <p class="hero__lead cp-text-body-large">
      Com a correção só pela inflação, o mínimo de {r.ultimo.ano} seria
      <strong class="destaque">{reais(r.ultimo.cenario)}</strong>
      <Fonte id={inpcFinal.fonte} />, e não <span class="junto">{reais(r.ultimo.real)} <Fonte id={MINIMO_ATUAL.fonte} />.</span>
    </p>
    <div class="hero__numero" data-numero>
      <Stat surface="red" value={f.porMes} label="a menos por mês para quem ganha 1 salário mínimo" />
      <p class="cp-text-body-small">
        Valor do decreto <Fonte id={MINIMO_ATUAL.fonte} /> menos o mínimo corrigido só pelo <span class="junto">INPC <Fonte id={inpcFinal.fonte} />.</span>
      </p>
    </div>
  </Fragment>

  <section class="secao secao--cinza" aria-labelledby="calcule">
    <div class="cp-container simulador">
      <form class="cartao simulador__form so-com-js" id="form-simulador">
        <h2 id="calcule" class="cp-text-h2">Calcule a sua perda</h2>
        <TextField
          id="salarios"
          label="Quantos salários mínimos você ganha por mês?"
          inputMode="decimal"
          autoComplete="off"
          defaultValue="1"
          helperText="Ex.: 1, 1,5 ou 2"
        />
      </form>

      <div class="cartao simulador__resultado" data-numero>
        <h2 class="cp-text-h2 so-sem-js">Resultado para 1 salário mínimo</h2>
        <p class="cp-text-body-large resultado__frase" aria-live="polite" data-saida="perda">{f.perda}</p>
        <Resultados
          itens={[
            { saida: 'porMes', valor: f.porMes, rotulo: `a menos por mês em ${r.ultimo.ano}` },
            { saida: 'porAno', valor: f.porAno, rotulo: `a menos em ${r.ultimo.ano}, com o 13º` },
            { saida: 'acumulada', valor: f.acumulada, rotulo: `a menos de ${CENARIO_SM.anoBase} a ${r.ultimo.ano}` },
          ]}
        />
        <p class="cp-text-body-small">
          Contas com os valores do <Fonte id={MINIMO_ATUAL.fonte} /> e o INPC do <Fonte id={inpcFinal.fonte} />.
          <Link href={link(PAGINAS.comoCalculamos.path)}>Veja como calculamos</Link>
        </p>
      </div>
    </div>
  </section>

  <section class="secao" aria-labelledby="ano-a-ano">
    <div class="cp-container">
      <figure class="grafico-cartao" data-numero>
        <figcaption>
          <h2 id="ano-a-ano" class="cp-text-h2">Ano a ano</h2>
          <ul class="legenda" aria-hidden="true">
            <li><span class="legenda__cor legenda__cor--lula"></span>Governo Lula (aumento acima da inflação)</li>
            <li><span class="legenda__cor legenda__cor--bolsonaro"></span>Regra do governo do Bolsonaro (só inflação)</li>
          </ul>
        </figcaption>
        <div class="grafico-area" data-grafico set:html={graficoSalario(DADOS_SALARIO, ESTADO_PADRAO)} />
        <p class="cp-text-body" data-saida="resumo">{f.resumo}</p>
        <details class="tabela-detalhes">
          <summary>Ver os números</summary>
          <div class="tabela-rolagem">
            <table class="tabela">
              <caption class="cp-visually-hidden">Salário mínimo em dezembro de cada ano: governo Lula e regra do governo do Bolsonaro</caption>
              <thead>
                <tr><th scope="col">Ano</th><th scope="col">Governo Lula</th><th scope="col">Regra do Bolsonaro</th><th scope="col">Diferença</th></tr>
              </thead>
              <tbody>
                {
                  r.anos.map((a) => (
                    <tr>
                      <th scope="row">{a.ano}</th>
                      <td>
                        {reais(a.real)} <Fonte id={fonteDezembro(a.ano)} />
                      </td>
                      <td>
                        <span data-saida={`cen-${a.ano}`}>{reais(a.cenario)}</span>{' '}
                        {a.ano === CENARIO_SM.anoBase ? (
                          <>
                            <Fonte id={padrao.fonte} />
                          </>
                        ) : (
                          <>
                            <Fonte id={fonteInpc(a.ano)} />
                            <span class="cp-visually-hidden">(INPC {pct(INPC.find((i) => i.aplicadoNoMinimoDe === a.ano)!.pct)})</span>
                          </>
                        )}
                      </td>
                      <td><span data-saida={`dif-${a.ano}`}>{reais(a.real - a.cenario)}</span></td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </details>
      </figure>
    </div>
  </section>

  <section class="secao secao--cinza" aria-labelledby="historico">
    <div class="cp-container">
      <h2 id="historico" class="cp-text-h2">De FHC a Lula: só no governo do Bolsonaro o mínimo perdeu poder de compra</h2>
      <p class="texto" data-numero>
        Descontada a inflação, o salário mínimo subiu em todos os governos desde o Plano Real, menos no do Bolsonaro, em que perdeu
        {h.bolsonaro.replace('−', '')} do poder de compra. No governo Lula, de 2003 a 2010, subiu {h.lula1}; no de FHC, {h.fhc}
        <span class="junto"><Fonte id={fonteHistorico} />.</span>
      </p>
      <div class="cartao simulador__resultado perda-bolsonaro" data-numero>
        <h3 class="cp-text-h3">Quanto o mínimo perdeu no governo do Bolsonaro</h3>
        <p class="cp-text-body-large resultado__frase">
          Em dinheiro de hoje, o mínimo valia {reais(Math.round(pb.inicio))} quando Bolsonaro assumiu e
          {reais(Math.round(pb.fim))} quando ele saiu.
        </p>
        <Resultados
          itens={[
            { saida: 'bolsonaro-fim', valor: reaisComSinal(Math.round(pb.perdaFim)), rotulo: `por mês no fim do governo (${pctComSinal(pb.pctFim, 1)})` },
            {
              saida: 'bolsonaro-pior',
              valor: reaisComSinal(Math.round(pb.pior.perda)),
              rotulo: `por mês em ${mesPorExtenso(pb.pior.referencia)}, o pior momento (${pctComSinal(pb.pior.pct, 1)})`,
            },
          ]}
        />
        <div class="grafico-area" set:html={graficoPerdaBolsonaro(SALARIO_MINIMO_REAL)} />
        <p class="cp-text-body-small">
          Diferença para dezembro de 2018, o mês antes da posse, em reais de {mesFinal}. Em todos os outros governos desde o Plano
          Real, o mínimo terminou valendo mais do que quando o governo começou <span class="junto"><Fonte id={fonteHistorico} />.</span>
        </p>
      </div>
      <figure class="grafico-cartao cartao" data-numero>
        <figcaption class="cp-text-title">Quanto o mínimo subiu além da inflação, por ano, em cada governo</figcaption>
        <div class="grafico-area" set:html={graficoGovernos(SALARIO_MINIMO_REAL)} />
        <p class="cp-text-body-small">
          Do último mês do governo anterior ao último mês de cada governo; o atual vai até {mesFinal}. Valores em reais de {mesFinal},
          corrigidos pelo INPC <span class="junto"><Fonte id={fonteHistorico} />.</span>
        </p>
      </figure>
      <figure class="grafico-cartao cartao" data-numero>
        <figcaption>
          <p class="cp-text-title">O mínimo em dezembro de cada ano, em reais de hoje</p>
          <ul class="legenda" aria-hidden="true">
            <li><span class="legenda__cor legenda__cor--lula"></span>Governo Lula</li>
            <li><span class="legenda__cor legenda__cor--bolsonaro"></span>Governo do Bolsonaro</li>
            <li><span class="legenda__cor legenda__cor--outros"></span>Outros governos</li>
          </ul>
        </figcaption>
        <div class="grafico-area" set:html={graficoAnoAAno(SALARIO_MINIMO_REAL)} />
        <p class="cp-text-body-small">
          Começa em dezembro de 1994, o primeiro fim de ano do real. A última coluna é {mesFinal}
          <span class="junto"><Fonte id={fonteHistorico} />.</span>
        </p>
        <details class="tabela-detalhes">
          <summary>Ver os números</summary>
          <div class="tabela-rolagem">
            <table class="tabela">
              <caption class="cp-visually-hidden">Salário mínimo em dezembro de cada ano: valor da época e valor em reais de hoje</caption>
              <thead>
                <tr><th scope="col">Mês</th><th scope="col">Valor na época</th><th scope="col">Em reais de {mesFinal}</th></tr>
              </thead>
              <tbody>
                {
                  mesesDoGrafico(SALARIO_MINIMO_REAL).map((m) => (
                    <tr>
                      <th scope="row">{mesAno(m.referencia)}</th>
                      <td>{reais(m.nominal)}</td>
                      <td>{reais(m.real)}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </details>
      </figure>
    </div>
  </section>

  <div class="cp-container">
    <BarraCompartilhar textoWhatsapp={f.whatsapp(url)} />
  </div>

  <div class="cp-container secao secao--fim">
    <LinksSimulador atual="salarioMinimo" />
  </div>

  <script slot="fim" type="application/json" id="dados-salario" set:html={dados} />
</Base>

<script>
  import '../scripts/sim-salario';
</script>
