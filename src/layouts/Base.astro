---
import '@boralula/ui/styles.css';
import '../styles/global.css';
import { BrandStripes, Tag } from '@boralula/ui';
import fonteTitulo from '../assets/fonts/montserrat-latin-800-normal.woff2?url';
import fonteTexto from '../assets/fonts/montserrat-latin-700-normal.woff2?url';
import Seo from '../components/Seo.astro';
import { SiteHeader } from '../components/SiteHeader';
import { SiteFooter } from '../components/SiteFooter';
import { VoltarInicio } from '../components/VoltarInicio';
import { PainelFonte } from '../components/PainelFonte';
import ResumoCovid from '../components/ResumoCovid.astro';
import { ICONE_PAGINA, Selo } from '../icones';
import { PAGINAS, dataPorExtenso, type PaginaId, link } from '../site';

interface Props {
  /** Página do registro em site.ts. Sem ela (404), passe titulo e descricao. */
  id?: PaginaId;
  titulo?: string;
  descricao?: string;
  /** Rótulo curto acima do título no hero, ex.: "Simulador". */
  selo?: string;
  /** Imagem Open Graph 1200×630. */
  imagem?: { src: string; alt: string };
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
}

const { id, selo, jsonLd = [], noindex = false } = Astro.props;
// Páginas sem imagem própria usam a da Início.
const imagem = Astro.props.imagem ?? { src: '/og/inicio.png', alt: PAGINAS.inicio.titulo };
const pagina = id ? PAGINAS[id] : undefined;
const titulo = pagina?.titulo ?? Astro.props.titulo!;
const descricao = pagina?.descricao ?? Astro.props.descricao!;
const interna = pagina && id !== 'inicio';

const breadcrumb = interna && {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [PAGINAS.inicio, pagina].map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: p.rotulo,
    item: new URL(link(p.path), Astro.site).href,
  })),
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#087A23" />
    <!-- Marca que há JS (mostra os controles dos simuladores).
         Economia de dados: fonte do sistema e nada de preload. Senão, preload dos dois pesos da Montserrat. -->
    <script is:inline define:vars={{ fontes: [fonteTitulo, fonteTexto] }}>
      document.documentElement.classList.add('js');
      var c = navigator.connection;
      if (c && c.saveData) {
        document.documentElement.classList.add('save-data');
      } else {
        fontes.forEach(function (href) {
          var l = document.createElement('link');
          l.rel = 'preload';
          l.as = 'font';
          l.type = 'font/woff2';
          l.crossOrigin = 'anonymous';
          l.href = href;
          document.head.appendChild(l);
        });
      }
    </script>
    <Seo
      titulo={titulo}
      descricao={descricao}
      path={pagina?.path}
      imagem={imagem}
      noindex={noindex}
      jsonLd={breadcrumb ? [...jsonLd, breadcrumb] : jsonLd}
    />
    <link rel="icon" href={link('/favicon.svg')} type="image/svg+xml" />
    <!-- Barra compartilhada dos Aplicativos da Virada: entra no início do body, numa Shadow DOM própria. -->
    <script is:inline src="https://barra.comitedetecnologia.com.br/barra.js" defer></script>
  </head>
  <body class="cp-body">
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>
    <SiteHeader atual={id} />
    <main id="conteudo">
      <section class="hero" aria-labelledby="titulo-pagina">
        <div class="hero__arte" aria-hidden="true"><BrandStripes base="red" /></div>
        <div class="cp-container hero__conteudo">
          {interna && <VoltarInicio />}
          {
            (selo || (id && ICONE_PAGINA[id])) && (
              <div class="hero__selos">
                {id && ICONE_PAGINA[id] && <Selo icone={ICONE_PAGINA[id]} tamanho="lg" />}
                {selo && <Tag tone="neutral">{selo}</Tag>}
              </div>
            )
          }
          <h1 id="titulo-pagina" class="cp-text-h1 hero__titulo">{titulo}</h1>
          <slot name="lead" />
        </div>
      </section>
      <slot />
      {id !== 'covid' && <ResumoCovid />}
      {
        pagina && (
          <div class="cp-container">
            <p class="atualizado cp-text-body-small">
              Atualizado em <time datetime={pagina.atualizadoEm}>{dataPorExtenso(pagina.atualizadoEm)}</time>
            </p>
          </div>
        )
      }
    </main>
    <SiteFooter />
    <slot name="fim" />
    <PainelFonte />
    <script>
      import '../scripts/menu';
      import '../scripts/fonte';
      import '../scripts/animacoes';
    </script>
  </body>
</html>
